{
  "name": "beautiful-react-table",
  "version": "8.0.0",
  "description": "Feature-rich React data table: column customization with drag & drop, frozen rows and columns, server-side filters, aggregates, row actions and pagination.",
  "keywords": [
    "react",
    "table",
    "data-table",
    "datagrid",
    "typescript",
    "drag-and-drop",
    "filters",
    "pagination",
    "mui"
  ],
  "author": "Samvel Baghdasaryan (https://github.com/samvel97)",
  "license": "MIT",
  "homepage": "https://pandatecham.github.io/web-lib-panda-table/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PandaTechAM/web-lib-panda-table.git"
  },
  "bugs": {
    "url": "https://github.com/PandaTechAM/web-lib-panda-table/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css",
    "./legacy-global.css": "./dist/legacy-global.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "npm run typecheck && vite build && node scripts/copy-legacy-css.mjs",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@mui/material": "^5.15.14 || ^6.0.0 || ^7.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/x-date-pickers": "^8.29.5",
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@mui/material": "^7.3.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.107.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^5.1.0"
  }
}
